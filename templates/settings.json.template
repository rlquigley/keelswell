{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment_project_name": "PROJECT_NAME_PLACEHOLDER",
  "$comment_keelswell_version": "0.1.0",
  "model": "MODEL_ORCHESTRATOR",
  "reasoningEffort": "REASONING_ORCHESTRATOR",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Edit(/**/docs/wave-*/evaluation-*.md)",
      "Edit(/.bmad/**/wave.md)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "Bash(gh auth token*)"
    ]
  },
  "contextWindow": "200K",
  "subagentModels": {
    "research": "MODEL_RESEARCH",
    "coding": "MODEL_CODING",
    "adversarial": "MODEL_ADVERSARIAL",
    "fallback": "MODEL_FALLBACK"
  },
  "subagentReasoning": {
    "research": "REASONING_RESEARCH",
    "coding": "REASONING_CODING",
    "adversarial": "REASONING_ADVERSARIAL"
  },
  "mcpServers": {
    "keelswell": {
      "transport": "stdio",
      "command": "keelswell-mcp",
      "args": []
    }
  },
    "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Monitor",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/wave-gate.sh", "args": [], "timeout": 30 }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/wave-evaluator-record.sh", "args": [], "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/em-dash-scrub.sh" }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/wave-evaluator-record.sh", "args": [], "timeout": 30 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "keelswell-wave-evaluator",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/wave-evaluator-record.sh", "args": [], "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/wrap-reminder.sh" },
          { "type": "command", "command": ".claude/hooks/wave-session-end.sh" }
        ]
      }
    ]
  },
  "skillsPaths": [
    ".claude/skills"
  ],
  "agentNamesFile": "_bmad/keelswell/config/agent-names.yaml"
}
